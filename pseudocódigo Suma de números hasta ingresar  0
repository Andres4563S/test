Algoritmo Suma_hasta_cero
Inicio
    Definir n, suma Como Entero
    suma <- 0
    Escribir "Ingrese un numero (0 para terminar):"
    Leer n
    Mientras n <> 0 Hacer
        suma <- suma + (n)
        Escribir "Ingrese un numero (0 para terminar):"
        Leer n
    FinMientras
    Escribir "La suma total es: ", suma
FinAlgoritmo
