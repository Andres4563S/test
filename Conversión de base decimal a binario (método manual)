Algoritmo Decimal_a_binario
Inicio
    Definir numero, residuo Como Entero
    Definir binario Como Caracter
 
    Escribir "Ingrese un numero entero decimal no negativo:"
    Leer numero
    Mientras numero < 0 Hacer
        Escribir "El numero debe ser no negativo"
        Escribir "Ingrese un numero entero decimal no negativo:"
        Leer numero
    FinMientras
 
    binario <- ""
    Si numero = 0 Entonces
        binario <- "0"
    SiNo
        Mientras numero > 0 Hacer
            residuo <- numero MOD 2
            binario <- Concatenar(ConvertirATexto(residuo), binario)
            numero <- Trunc(numero / 2)
        FinMientras
    FinSi
 
    Escribir "Representacion binaria: ", binario
Fin
