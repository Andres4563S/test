Algoritmo Clasificacion_triangulo
Inicio
    Definir angulo1, angulo2, angulo3, suma, mayor Como Real
 
    Escribir "Ingrese el primer angulo:"
    Leer angulo1
    Escribir "Ingrese el segundo angulo:"
    Leer angulo2
    Escribir "Ingrese el tercer angulo:"
    Leer angulo3
 
    suma <- angulo1 + angulo2 + angulo3
 
    Si angulo1 <= 0 O angulo2 <= 0 O angulo3 <= 0 O suma <> 180 Entonces
        Escribir "Error: los angulos no forman un triangulo"
    SiNo
        mayor <- angulo1
        Si angulo2 > mayor Entonces
            mayor <- angulo2
        FinSi
        Si angulo3 > mayor Entonces
            mayor <- angulo3
        FinSi
 
        Si mayor < 90 Entonces
            Escribir "El triangulo es acutangulo"
        SiNo
            Si mayor = 90 Entonces
                Escribir "El triangulo es rectangulo"
            SiNo
                Escribir "El triangulo es obtusangulo"
            FinSi
        FinSi
    FinSi
Fin
