Algoritmo Energia_electrica
Inicio
    Definir potencia, horas, tarifa, consumo, costo Como Real
 
    Escribir "Ingrese la potencia del electrodomestico en W:"
    Leer potencia
    Mientras potencia <= 0 Hacer
        Escribir "La potencia debe ser mayor que 0"
        Escribir "Ingrese la potencia del electrodomestico en W:"
        Leer potencia
    FinMientras
 
    Escribir "Ingrese las horas de uso diario (0 a 24):"
    Leer horas
    Mientras horas < 0 O horas > 24 Hacer
        Escribir "Las horas deben estar entre 0 y 24"
        Escribir "Ingrese las horas de uso diario (0 a 24):"
        Leer horas
    FinMientras
 
    Escribir "Ingrese la tarifa por kWh:"
    Leer tarifa
    Mientras tarifa < 0 Hacer
        Escribir "La tarifa no puede ser negativa"
        Escribir "Ingrese la tarifa por kWh:"
        Leer tarifa
    FinMientras
 
    consumo <- (potencia / 1000) * horas * 30
    costo <- consumo * tarifa
 
    Escribir "Consumo mensual: ", consumo, " kWh"
    Escribir "Costo mensual: $", costo
Fin
