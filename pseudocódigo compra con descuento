Algoritmo compra_con_descuento
Inicio
   Definir P, IVA, PIVA, PD, PCD, PF como real
    IVA <- 0.15
   Escribir "Ingresar el valor del producto"
    Leer P
   Mientras P <= 0 hacer
    Escribir "El valor de producto no puede ser menor ni igual a 0"
    Escribir "Ingresar el valor del producto"
     Leer P  
   FinMientras
   PD <- P*0.20 
   PCD <- P-PD
   PIVA <- PCD*IVA
   PF <- PCD+PIVA
   Escribir "Descuento aplicado", PD
   Escribir "Precio con el descuento", PCD
   Escribir "IVA aplicado", PIVA
   Escribir "Precio final", PF
Fin
